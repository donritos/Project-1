{
  "schema_version": "2.0.0",
  "feature_version": "features-v2-final-tier",
  "policy_version": "policy-v2-event",
  "dataset_ids": {
    "train": "kelvins_train",
    "test": "kelvins_test"
  },
  "paths": {
    "raw_train": "data/raw/train_data.csv",
    "raw_test": "data/raw/test_data.csv",
    "event_labels": "data/raw/challenge1_event_labels.xlsx",
    "processed_dir": "data/processed",
    "artifacts_dir": "artifacts"
  },
  "horizon": {
    "min_days": 2.0
  },
  "units": {
    "miss_distance": "m",
    "relative_position": "m",
    "relative_speed": "m/s",
    "sigma": "m",
    "time_to_tca": "days",
    "risk": "log10(Pc)"
  },
  "max_risk_estimate_encoding": "log10",
  "clip_to_max_risk_estimate": false,
  "allowed_input_columns": [
    "event_id",
    "time_to_tca",
    "miss_distance",
    "relative_speed",
    "relative_position_r",
    "relative_position_t",
    "relative_position_n",
    "c_object_type",
    "c_sigma_r",
    "t_sigma_r",
    "max_risk_estimate",
    "F10",
    "AP"
  ],
  "target_column": "risk",
  "required_geometry_columns": [
    "time_to_tca",
    "miss_distance",
    "relative_position_r",
    "relative_position_t",
    "relative_position_n"
  ],
  "optional_columns": [
    "relative_speed",
    "c_object_type",
    "c_sigma_r",
    "t_sigma_r",
    "max_risk_estimate",
    "F10",
    "AP"
  ],
  "thresholds": {
    "critical_risk": -4.0,
    "elevated_risk": -6.0,
    "critical_distance_m": 1000.0,
    "elevated_distance_max_m": 5000.0,
    "distance_band_inclusive": true
  },
  "features": {
    "use_past_risk": true,
    "history_enabled": true,
    "epsilon_m": 1.0,
    "sigma_floor_m": 0.01,
    "speed_floor_mps": 0.1,
    "rtn_norm_tolerance": 0.01,
    "sigma_suspicious_m": 1000000.0,
    "object_type_categories": [
      "DEBRIS",
      "UNKNOWN",
      "PAYLOAD",
      "ROCKET BODY",
      "TBA"
    ]
  },
  "split": {
    "seed": 42,
    "holdout": 0.2,
    "cv_folds": 3
  },
  "model": {
    "training_rows": "auto",
    "class_weight_cap": 10.0,
    "n_search": 2,
    "learning_rate": [
      0.02,
      0.06
    ],
    "num_leaves": [
      7,
      31
    ],
    "min_child_samples": [
      30,
      200
    ],
    "feature_fraction": [
      0.7,
      1.0
    ],
    "lambda_l2": [
      0.0,
      1.0,
      10.0
    ],
    "max_rounds": 300,
    "early_stopping_rounds": 30,
    "target_floor": -30.0,
    "num_threads": 0
  },
  "calibration": {
    "method": "isotonic"
  },
  "conformal_sets": {
    "enabled": true,
    "coverage": 0.9,
    "method": "lac"
  },
  "triage": {
    "watch_max_share": 0.05,
    "deescalation_p_critical": 0.5,
    "auto_clear_zero_missed": true,
    "trends": {
      "miss_shrink_slope": 0.02,
      "risk_rise_slope": -0.1,
      "sigma_grow_slope": -0.05,
      "mre_volatility": 0.5,
      "risk_volatility": 1.5
    },
    "auto_clear_allowed_flags": [
      "MISSING_SPACE_WEATHER"
    ]
  }
}