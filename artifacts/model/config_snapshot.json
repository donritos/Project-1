{
  "schema_version": "1.0.0",
  "feature_version": "features-v1",
  "policy_version": "policy-v1",
  "dataset_ids": {
    "train": "kelvins_train",
    "test": "kelvins_test"
  },
  "paths": {
    "raw_train": "data/raw/train_data.csv",
    "raw_test": "data/raw/test_data.csv",
    "processed_dir": "data/processed",
    "artifacts_dir": "artifacts"
  },
  "units": {
    "miss_distance": "m",
    "relative_position": "m",
    "relative_speed": "m/s",
    "sigma": "m",
    "time_to_tca": "days",
    "risk": "log10(Pc)"
  },
  "max_risk_estimate_encoding": "log10",
  "clip_to_max_risk_estimate": false,
  "allowed_input_columns": [
    "event_id",
    "time_to_tca",
    "miss_distance",
    "relative_speed",
    "relative_position_r",
    "relative_position_t",
    "relative_position_n",
    "c_object_type",
    "c_sigma_r",
    "t_sigma_r",
    "max_risk_estimate",
    "F10",
    "AP"
  ],
  "target_column": "risk",
  "required_geometry_columns": [
    "time_to_tca",
    "miss_distance",
    "relative_position_r",
    "relative_position_t",
    "relative_position_n"
  ],
  "optional_columns": [
    "relative_speed",
    "c_object_type",
    "c_sigma_r",
    "t_sigma_r",
    "max_risk_estimate",
    "F10",
    "AP"
  ],
  "thresholds": {
    "critical_risk": -4.0,
    "elevated_risk": -6.0,
    "critical_distance_m": 1000.0,
    "elevated_distance_max_m": 5000.0,
    "distance_band_inclusive": true
  },
  "features": {
    "epsilon_m": 1.0,
    "sigma_floor_m": 0.01,
    "speed_floor_mps": 0.1,
    "rtn_norm_tolerance": 0.01,
    "sigma_suspicious_m": 1000000.0,
    "object_type_categories": [
      "DEBRIS",
      "UNKNOWN",
      "PAYLOAD",
      "ROCKET BODY",
      "TBA"
    ],
    "history_enabled": true
  },
  "split": {
    "seed": 42,
    "dev": 0.6,
    "policy_cal": 0.15,
    "conformal_cal": 0.1,
    "eval": 0.15,
    "test_horizon_min_days": 2.0
  },
  "model": {
    "objective_candidates": [
      "l1",
      "l2"
    ],
    "n_search": 10,
    "cv_folds": 5,
    "learning_rate": [
      0.03,
      0.05
    ],
    "num_leaves": [
      15,
      31
    ],
    "min_child_samples": [
      50,
      200
    ],
    "feature_fraction": [
      0.8,
      1.0
    ],
    "lambda_l2": [
      0.0,
      10.0
    ],
    "max_rounds": 1000,
    "early_stopping_rounds": 50,
    "target_floor": -30.0
  },
  "conformal": {
    "coverage": 0.9,
    "min_calibration_events": 30
  },
  "triage": {
    "review_upper_threshold": -4.0,
    "auto_clear_upper_threshold": -6.0,
    "classifier_disagreement_prob": 0.5,
    "auto_clear_allowed_flags": [
      "MISSING_SPACE_WEATHER"
    ]
  },
  "interval": {
    "method": "cqr",
    "quantile_alphas": [
      0.05,
      0.95
    ]
  }
}